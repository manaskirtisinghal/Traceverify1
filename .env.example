# Copy to .env (project root) and fill in your own password. Never commit .env.
# SQLAlchemy URL for the main evidence database (psycopg 3 driver)
DATABASE_URL=postgresql+psycopg://traceverify:YOUR_PASSWORD@localhost:5432/traceverify

# Separate database used only by the automated integration tests (it is wiped by the tests)
TEST_DATABASE_URL=postgresql+psycopg://traceverify:YOUR_PASSWORD@localhost:5432/traceverify_test

# Browser origins allowed to call the API directly (the Vite dev proxy does not need this).
# Exact origins, comma-separated (e.g. your Vercel URL), and/or a regex.
CORS_ORIGINS=
CORS_ORIGIN_REGEX=^http://(localhost|127\.0\.0\.1)(:\d+)?$

# Optional: default investigation parameters (each can be overridden per request)
# DEFAULT_THRESHOLD=0.60   (fixed system setting: applies to every investigation, not overridable per request)
# DEFAULT_WINDOW_BEFORE=300
# DEFAULT_WINDOW_AFTER=1800
# DEFAULT_TEMPORAL_DECAY=300
